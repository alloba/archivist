    "url": "https://gitlab.com/alloba/archivisit/issues"
  },
  "homepage": "https://gitlab.com/alloba/archivisit#readme",
  "devDependencies": {
    "@types/minimist": "^1.2.2",
    "@types/node": "^18.0.0",
    "typescript": "^4.7.4"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "bottleneck": "^2.19.5",
    "minimist": "^1.2.6",
    "node-fetch": "^3.2.6"
  }
