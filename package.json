{
  "name": "archivist",
  "version": "1.0.0",
  "description": "Scan sources for media and save results.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "tsc && node --test \"build/**/*.test.js\"",
    "build": "npx tsc",
    "seed-s3-manifest": "tsc && node build/tools/seedS3Manifest.js",
    "prune-s3-from-report": "tsc && node build/tools/pruneS3FromReport.js",
    "prestart": "npx tsc",
    "start": "node ./build/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@gitlab.com/alloba/archivisit.git"
  },
  "author": "Alloba",
